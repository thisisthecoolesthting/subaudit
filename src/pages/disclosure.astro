---
import CompliantLayout from '@/layouts/CompliantLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import home from '@/data/spawn-home.json';

const b = home.brand;
const support = (home as { supportEmail?: string }).supportEmail || 'hello@subaudit.org';
const associateTag = import.meta.env.PUBLIC_ASSOCIATE_TAG ?? 'subaudit-20';
---

<CompliantLayout title="Partner Disclosure" sectionAds="legal">
  <PageIntro eyebrow="Transparency" title="Partner disclosure" description={`How affiliate links work on ${b.fullName} — and what we will not do for money.`} />

  <section class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <article class="content-panel max-w-prose mx-auto prose prose-lg prose-ink">
      <p class="!mt-0">
        {b.fullName} is a participant in the Amazon Services LLC Associates
        Program, an affiliate advertising program designed to provide a means for
        sites to earn advertising fees by advertising and linking to Amazon.com.
        Our Amazon Associates store ID is <strong>{associateTag}</strong>.
      </p>
      <p>
        We also participate in SaaS and software affiliate programs (Impact, PartnerStack,
        brand-direct). Whenever we link to a subscription, trial, or product, we may earn a
        commission if you sign up or buy. Your price doesn&rsquo;t change.
      </p>
      <p>
        We never accept payment to recommend a service or rank it higher. We&rsquo;ve turned down
        paid sponsorships and undisclosed partner deals because they
        compromise the only thing we have: your trust.
      </p>
      <p>
        If you have questions about any specific recommendation, please
        reach out: <a href={`mailto:${support}`}>{support}</a>.
      </p>
    </article>
  </section>
</CompliantLayout>
