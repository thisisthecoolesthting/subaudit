---
/**
 * Site-wide bottom strip: fleet phone-case promos (no outbound retailer cards).
 */
import SiteSectionAds from '@/components/SiteSectionAds.astro';
import home from '@/data/spawn-home.json';

const disablePhonePromos = (home as { disablePhonePromos?: boolean }).disablePhonePromos === true;
---

<section
  class="not-prose border-t border-cream-200 section-band relative overflow-hidden"
  aria-labelledby="global-bottom-picks-heading"
>
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
      <div>
        <p class="font-mono text-[11px] tracking-[0.18em] uppercase text-terracotta-600 font-medium mb-2">
          Before you leave
        </p>
        <h2
          id="global-bottom-picks-heading"
          class="font-display text-2xl md:text-3xl text-ink-900 !mt-0 leading-tight max-w-[22ch]"
        >
          More from our tracked reviews
        </h2>
      </div>
      <p class="text-sm text-ink-700 max-w-[40ch] leading-relaxed">
        Browse independent price-history write-ups on household staples, subscriptions, and gear.
      </p>
    </div>

    <div class="flex flex-wrap gap-4 items-center justify-between text-sm">
      <a href="/products/" class="btn-primary no-underline">
        All product reviews →
      </a>
      <a href="/articles/" class="text-terracotta-600 hover:underline no-underline">
        Latest articles
      </a>
    </div>

    {!disablePhonePromos && (
      <div class="mt-10 pt-8 border-t border-dashed border-cream-200/90">
        <SiteSectionAds page="home" variant="footer" />
      </div>
    )}
  </div>
</section>
